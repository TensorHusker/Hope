android {
    namespace = "com.hope.game"
    compileSdk = 34

    defaultConfig {
        applicationId = "com.hope.game"
        minSdk = 24
        targetSdk = 34
        versionCode = 1
        versionName = "1.0.0"

        testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
        
        // NDK configuration for optimal performance
        ndk {
            abiFilters += listOf("arm64-v8a", "armeabi-v7a", "x86_64")
            
            // Optimize for specific architectures
            if (project.hasProperty("targetAbi")) {
                abiFilters.clear()
                abiFilters += project.property("targetAbi") as String
            }
        }
        
        // External native build with optimizations
        externalNativeBuild {
            cmake {
                cppFlags += listOf(
                    "-std=c++17",
                    "-O3",                    // Maximum optimization
                    "-ffast-math",            // Fast floating point
                    "-funroll-loops",         // Loop unrolling
                    "-ftree-vectorize",       // Auto-vectorization
                    "-march=native",          // CPU-specific optimizations
                    "-flto",                  // Link-time optimization
                    "-fomit-frame-pointer",   // Omit frame pointer
                    "-DNDEBUG"               // Remove debug code
                )
                
                arguments += listOf(
                    "-DANDROID_STL=c++_shared",
                    "-DANDROID_ARM_MODE=arm",
                    "-DANDROID_ARM_NEON=TRUE",
                    "-DCMAKE_BUILD_TYPE=Release"
                )
            }
        }
        
        // Vector drawables for smaller APK
        vectorDrawables {
            useSupportLibrary = true
        }
        
        // Resource configuration
        resourceConfigurations += listOf("en", "xxhdpi")
    }

    buildTypes {
        release {
            isMinifyEnabled = true
            isShrinkResources = true
            isDebuggable = false
            
            // ProGuard/R8 optimization
            proguardFiles(
                getDefaultProguardFile("proguard-android-optimize.txt"),
                "proguard-rules-optimized.pro"
            )
            
            // Native debug symbols
            ndk {
                debugSymbolLevel = "SYMBOL_TABLE"
            }
            
            // Optimize APK
            packagingOptions {
                resources {
                    excludes += listOf(
                        "META-INF/**",
                        "kotlin/**",
                        "**.proto",
                        "**.bin"
                    )
                }
            }
            
            // Signing config
            signingConfig = signingConfigs.getByName("release")
            
            // Build config fields
            buildConfigField("boolean", "ENABLE_CRASHLYTICS", "true")
            buildConfigField("boolean", "ENABLE_ANALYTICS", "true")
            buildConfigField("boolean", "ENABLE_PERFORMANCE_MONITORING", "true")
        }
        
        debug {
            isMinifyEnabled = false
            isDebuggable = true
            
            // Debug-specific optimizations
            buildConfigField("boolean", "ENABLE_CRASHLYTICS", "false")
            buildConfigField("boolean", "ENABLE_ANALYTICS", "false")
            buildConfigField("boolean", "ENABLE_PERFORMANCE_MONITORING", "true")
            
            // Profile-guided optimization collection
            profileable = true
        }
        
        // Benchmark build type
        create("benchmark") {
            initWith(getByName("release"))
            signingConfig = signingConfigs.getByName("debug")
            matchingFallbacks += listOf("release")
            isDebuggable = false
            
            // Disable code coverage for benchmarks
            enableAndroidTestCoverage = false
            enableUnitTestCoverage = false
        }
    }
    
    // Compile options
    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
        
        // Enable incremental compilation
        isCoreLibraryDesugaringEnabled = true
    }
    
    // Kotlin options
    kotlinOptions {
        jvmTarget = "17"
        
        // Compiler flags for optimization
        freeCompilerArgs += listOf(
            "-opt-in=kotlin.RequiresOptIn",
            "-opt-in=kotlinx.coroutines.ExperimentalCoroutinesApi",
            "-opt-in=kotlin.ExperimentalStdlibApi",
            "-Xjvm-default=all",              // Generate default methods
            "-Xlambdas=indy",                 // Use invokedynamic for lambdas
            "-Xno-call-assertions",           // Remove call assertions
            "-Xno-param-assertions",          // Remove parameter assertions
            "-Xno-receiver-assertions",       // Remove receiver assertions
            "-Xopt-in=kotlin.contracts.ExperimentalContracts"
        )
    }
    
    // Build features
    buildFeatures {
        compose = true
        viewBinding = true
        buildConfig = true
        
        // Disable unused features
        aidl = false
        renderScript = false
        shaders = false
    }
    
    // Compose options
    composeOptions {
        kotlinCompilerExtensionVersion = "1.5.4"
        
        // Compose compiler optimizations
        useLiveLiterals = false  // Disable in release for performance
    }
    
    // External native build
    externalNativeBuild {
        cmake {
            path = file("src/main/cpp/CMakeLists.txt")
            version = "3.22.1"
        }
    }
    
    // Packaging options
    packagingOptions {
        jniLibs {
            useLegacyPackaging = false  // Use uncompressed native libraries
            
            // Keep only necessary ABIs in release
            if (gradle.startParameter.taskNames.any { it.contains("Release") }) {
                pickFirst("lib/armeabi-v7a/libc++_shared.so")
                pickFirst("lib/arm64-v8a/libc++_shared.so")
                pickFirst("lib/x86_64/libc++_shared.so")
            }
        }
        
        resources {
            excludes += listOf(
                "META-INF/DEPENDENCIES",
                "META-INF/LICENSE",
                "META-INF/LICENSE.txt",
                "META-INF/NOTICE",
                "META-INF/NOTICE.txt",
                "META-INF/ASL2.0",
                "META-INF/LGPL2.1",
                "META-INF/*.kotlin_module",
                "META-INF/proguard/**",
                "kotlin-tooling-metadata.json",
                "DebugProbesKt.bin"
            )
        }
        
        // Optimize DEX
        dex {
            useLegacyPackaging = false
        }
    }
    
    // Lint options for faster builds
    lint {
        checkReleaseBuilds = false
        abortOnError = false
        checkDependencies = false
        
        // Disable expensive checks
        disable += setOf(
            "UnusedResources",
            "IconDensities",
            "GoogleAppIndexingWarning",
            "MissingTranslation"
        )
    }
    
    // Test options
    testOptions {
        unitTests {
            isReturnDefaultValues = true
            isIncludeAndroidResources = true
        }
        
        // Disable animations for tests
        animationsDisabled = true
    }
    
    // ADB options
    adbOptions {
        installOptions("-r", "-d")  // Replace existing, allow downgrade
        timeOutInMs = 10 * 1000     // 10 second timeout
    }
    
    // Splits for APK size optimization
    splits {
        abi {
            isEnable = true
            reset()
            include("armeabi-v7a", "arm64-v8a", "x86_64")
            isUniversalApk = false
        }
        
        density {
            isEnable = false  // Use vector drawables instead
        }
    }
    
    // Bundle configuration
    bundle {
        language {
            enableSplit = true
        }
        density {
            enableSplit = true
        }
        abi {
            enableSplit = true
        }
    }
}

